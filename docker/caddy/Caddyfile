# Stack Gateway. One Caddyfile for Local Mode and Public Mode (ADR-0001).
# Local:  OB_SCHEME=http  OB_PUBLIC_DOMAIN=localhost      -> http://grafana.localhost
# Public: OB_SCHEME=https OB_PUBLIC_DOMAIN=example.com    -> https://grafana.example.com
# Behind platform-edge: OB_SCHEME=https, OB_LISTEN_SCHEME=http, OB_TLS_ISSUER=none
# Static config only: no Docker socket, no caddy-docker-proxy.
{
	admin off
	skip_install_trust
	# platform-edge (or any proxy on this host) may sit in front; keep its
	# X-Forwarded-Proto so Grafana sees https when TLS ends at the edge.
	servers {
		trusted_proxies static {$OB_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

(ca-none) {
}

(ca-acme) {
	tls {
		issuer acme
	}
}

(ca-internal) {
	tls internal
}

(app) {
	import ca-{$OB_TLS_ISSUER}
	encode zstd gzip
	# Operator surfaces stay on the Docker network; never through the gateway.
	@operator path_regexp (?i)^/+metrics(/|$)
	respond @operator 404
	reverse_proxy {args[0]}
}

(health) {
	@operator client_ip {$OB_OPERATOR_ALLOW:127.0.0.1/8 ::1}
	handle @operator {
		reverse_proxy {args[0]} {
			header_up Host {args[1]}
		}
	}
	handle {
		reverse_proxy {args[0]} {
			header_up Host {args[1]}
			handle_response {
				respond "" {rp.status_code}
			}
		}
	}
}

# Health routes are exact readiness probes; backend APIs stay private.
{$OB_LISTEN_SCHEME}://{$OB_PUBLIC_DOMAIN} {
	import ca-{$OB_TLS_ISSUER}
	handle /health/grafana {
		rewrite * /api/health
		import health grafana:3000 grafana:3000
	}
	handle /health/loki {
		rewrite * /ready
		import health loki:3100 loki:3100
	}
	handle /health/tempo {
		rewrite * /ready
		import health tempo:3200 tempo:3200
	}
	handle /health/mimir {
		rewrite * /ready
		import health mimir:8080 mimir:8080
	}
	handle /health/alloy {
		rewrite * /-/ready
		import health alloy:12345 alloy:12345
	}
	handle /health/gateway {
		rewrite * /health/litellm
		import health lg-gateway:80 {$OB_GATEWAY_HEALTH_HOST:localhost}
	}
	handle /health/backplane {
		rewrite * /health/ready
		import health bp-server:3000 bp-server:3000
	}
	handle /health/alerts {
		root * /srv/state
		@operatorPlaceholder {
			client_ip {$OB_OPERATOR_ALLOW:127.0.0.1/8 ::1}
			file /alerts-degraded.json
		}
		@placeholder file /alerts-degraded.json
		header Content-Type application/json
		respond @operatorPlaceholder `{"status":"degraded","problem":"alert_delivery_placeholder"}` 503
		respond @placeholder `{"status":"degraded"}` 503
		respond `{"status":"ready"}` 200
	}
	handle /versions.json {
		@operator client_ip {$OB_OPERATOR_ALLOW:127.0.0.1/8 ::1}
		handle @operator {
			root * /srv/state
			file_server
		}
		handle {
			header Content-Type application/json
			respond `{"status":"ok"}` 200
		}
	}
	handle {
		root * /srv/console
		file_server
	}
}

{$OB_LISTEN_SCHEME}://grafana.{$OB_PUBLIC_DOMAIN} {
	import app grafana:3000
}
