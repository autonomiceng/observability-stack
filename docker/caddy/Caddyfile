{
	admin off
	skip_install_trust
	default_sni 127.0.0.1
	auto_https disable_redirects
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp "[?].*$" ""
			}
		}
	}
	servers {
		trusted_proxies static {$OB_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

(access-log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp "[?].*$" ""
			}
		}
	}
}

(app) {
	import access-log
	import app-routes {args[0]}
}

(app-routes) {
	encode zstd gzip
	# Operator surfaces stay on the Docker network; never through the gateway.
	@operator path_regexp (?i)^/+metrics(/|$)
	respond @operator 404
	reverse_proxy {args[0]}
}

# The console's assets, STS, SigV4 and admin API share one origin on port 9001.
(rustfs-access) {
	@disabled expression `'{$OB_RUSTFS_CONSOLE:false}' != 'true'`
	respond @disabled "" 404
	@denied not client_ip {$OB_OPERATOR_ALLOW:127.0.0.1/8 ::1}
	respond @denied "" 404
}

(rustfs-routes) {
	route {
		import rustfs-access
		@landing {
			path /
			method GET HEAD
			header Accept *text/html*
		}
		redir @landing /rustfs/console/ 302
		# Preserve Host including port. Caddy trusts forwarding only from configured peers.
		reverse_proxy rustfs:9001
	}
}

(health) {
	@operator client_ip {$OB_OPERATOR_ALLOW:127.0.0.1/8 ::1}
	handle @operator {
		reverse_proxy {args[0]} {
			header_up Host {args[1]}
		}
	}
	handle {
		reverse_proxy {args[0]} {
			header_up Host {args[1]}
			handle_response {
				respond "" {rp.status_code}
			}
		}
	}
}

# Public allowlist only. The observer's private records have no Caddy mount.
(status) {
	handle /status.json {
		route {
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -Cookie
			# Prevent conditional/range requests from extending a frozen observation.
			request_header -If-None-Match
			request_header -If-Modified-Since
			request_header -If-Match
			request_header -If-Unmodified-Since
			request_header -If-Range
			request_header -Range
			header Content-Type application/json
			header Cache-Control no-store
			@unsupported not method GET HEAD
			header @unsupported Allow "GET, HEAD"
			respond @unsupported "" 405
			root * /srv/state
			@missing not file /status.json
			respond @missing "" 404
			file_server
		}
	}
}

(probes) {
	import status
	handle /health/status {
		respond "ok" 200
	}
	handle /health/grafana {
		rewrite * /api/health
		import health grafana:3000 grafana:3000
	}
	handle /health/loki {
		rewrite * /ready
		import health loki:3100 loki:3100
	}
	handle /health/tempo {
		rewrite * /ready
		import health tempo:3200 tempo:3200
	}
	handle /health/mimir {
		rewrite * /ready
		import health mimir:8080 mimir:8080
	}
	handle /health/alloy {
		rewrite * /-/ready
		import health alloy:12345 alloy:12345
	}
	handle /health/gateway {
		rewrite * /health/litellm
		import health lg-gateway:80 {$OB_GATEWAY_HEALTH_HOST:localhost}
	}
	handle /health/backplane {
		rewrite * /health/ready
		import health bp-server:3000 bp-server:3000
	}
	handle /health/alerts {
		root * /srv/state
		@operatorPlaceholder {
			client_ip {$OB_OPERATOR_ALLOW:127.0.0.1/8 ::1}
			file /alerts-degraded.json
		}
		@placeholder file /alerts-degraded.json
		header Content-Type application/json
		respond @operatorPlaceholder `{"status":"degraded","problem":"alert_delivery_placeholder"}` 503
		respond @placeholder `{"status":"degraded"}` 503
		respond `{"status":"ready"}` 200
	}
}

(console) {
	import access-log
	import console-routes
}

(console-routes) {
	import probes
	handle /links.json {
		root * /srv/state
		file_server
	}
	handle /versions.json {
		@operator client_ip {$OB_OPERATOR_ALLOW:127.0.0.1/8 ::1}
		handle @operator {
			root * /srv/state
			file_server
		}
		handle {
			header Content-Type application/json
			respond `{"status":"ok"}` 200
		}
	}
	handle {
		root * /srv/console
		file_server
	}
}

(rustfs-tls-local-false) {
}

(rustfs-tls-local-true) {
	https://{$OB_RUSTFS_HOST:rustfs.localhost} {
		tls internal
		header -Strict-Transport-Security
		import access-log
		import rustfs-routes
	}
}

(access-local) {
	import rustfs-tls-local-{$OB_RUSTFS_CONSOLE:false}
	:80 {
		header -Strict-Transport-Security
		import console
	}
	http://{$OB_RUSTFS_HOST:rustfs.localhost} {
		header -Strict-Transport-Security
		import access-log
		import rustfs-routes
	}
	http://{$OB_GRAFANA_HOST:grafana.localhost} {
		header -Strict-Transport-Security
		import app grafana:3000
	}
	https://{$OB_PUBLIC_DOMAIN:localhost}, https://127.0.0.1 {
		tls internal
		header -Strict-Transport-Security
		import console
	}
	https://{$OB_GRAFANA_HOST:grafana.localhost} {
		tls internal
		header -Strict-Transport-Security
		import app grafana:3000
	}
}

(rustfs-tls-public-false) {
}

(rustfs-tls-public-true) {
	https://{$OB_RUSTFS_HOST:rustfs.localhost} {
		tls {
			issuer acme
		}
		import access-log
		import rustfs-routes
	}
}

(access-public) {
	import rustfs-tls-public-{$OB_RUSTFS_CONSOLE:false}
	http://{$OB_RUSTFS_HOST:rustfs.localhost} {
		import access-log
		route {
			import rustfs-access
			redir https://{$OB_RUSTFS_HOST:rustfs.localhost}{$OB_PUBLIC_PORT_SUFFIX}{uri} 308
		}
	}
	http://{$OB_PUBLIC_DOMAIN} {
		import access-log
		import probes
		handle {
			redir https://{$OB_PUBLIC_DOMAIN}{$OB_PUBLIC_PORT_SUFFIX}{uri} 308
		}
	}
	http://{$OB_GRAFANA_HOST} {
		import access-log
		redir https://{$OB_GRAFANA_HOST}{$OB_PUBLIC_PORT_SUFFIX}{uri} 308
	}
	https://{$OB_PUBLIC_DOMAIN} {
		tls {
			issuer acme
		}
		import console
	}
	https://{$OB_GRAFANA_HOST} {
		tls {
			issuer acme
		}
		import app grafana:3000
	}
}

(access-proxy) {
	:80 {
		import access-log
		# Host matchers ignore ports. The external origin must match its full authority.
		@grafana expression `(host('{$OB_GRAFANA_HOST}') && !host('{$OB_GRAFANA_URL_HOST:unused.invalid}') && !host('{$OB_RUSTFS_URL_HOST:unused.invalid}')) || {http.request.hostport} == '{$OB_GRAFANA_AUTHORITY}'`
		@rustfs expression `(host('{$OB_RUSTFS_HOST:rustfs.localhost}') && !host('{$OB_RUSTFS_URL_HOST:unused.invalid}') && !host('{$OB_GRAFANA_URL_HOST:unused.invalid}')) || {http.request.hostport} == '{$OB_RUSTFS_AUTHORITY}'`
		handle @rustfs {
			import rustfs-routes
		}
		handle @grafana {
			import app-routes grafana:3000
		}
		handle {
			import console-routes
		}
	}
}

import access-{$OB_ACCESS_MODE:local}
