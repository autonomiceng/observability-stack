# Choose local (HTTP and self-signed HTTPS), public (trusted HTTPS for your domain), or proxy (another gateway handles HTTPS).
OB_ACCESS_MODE=local
# Root console hostname. 127.0.0.1 is also supported in local mode.
OB_PUBLIC_DOMAIN=localhost
# Explicit application hostname; empty derives grafana.<domain> (IP root: grafana.localhost).
OB_GRAFANA_HOST=
# Full browser origin, e.g. https://darkforge.tail694fe2.ts.net:8447; empty uses the settings above and suffix below.
# No trailing slash, path, credentials, query or fragment. Run bootstrap after changing it.
OB_GRAFANA_URL=
# Enable the native privileged human console only with the existing s3 storage profile.
OB_RUSTFS_CONSOLE=false
# Client IP/CIDR list for the native console only; independent of monitoring operator access.
OB_RUSTFS_CONSOLE_ALLOW=127.0.0.1/8 ::1
# Internal console hostname; empty derives rustfs.<domain> (IP root: rustfs.localhost).
OB_RUSTFS_HOST=
# Full RustFS browser origin, e.g. https://darkforge.tail694fe2.ts.net:8451; empty uses host/scheme/suffix.
# No trailing slash, path, credentials, query or fragment. Run bootstrap after changing it.
OB_RUSTFS_URL=
# Protocol in application links: empty uses http locally, https publicly or behind another gateway.
OB_SCHEME=
# Caddy bind interface. 0.0.0.0 exposes it to other hosts.
OB_BIND_HOST=127.0.0.1
# Published HTTP port.
OB_HTTP_PORT=80
# Published HTTPS port.
OB_HTTPS_PORT=443
# Browser URL port, such as :8080; derived locally/publicly, set explicitly behind another gateway.
OB_PUBLIC_PORT_SUFFIX=
# Shared Docker network. Disposable smoke projects use an isolated name.
OB_PLATFORM_NETWORK=platform
# Checkpoint destination. Mount and replicate off-host; contains sensitive data.
OB_BACKUP_DIR=./data/backups
# Collect Platform Edge metrics only when it is installed and allows this scraper IP.
OB_SCRAPE_EDGE=false
# Optional LLM gateway metrics. No sibling stack is required by default.
OB_SCRAPE_GATEWAY=false
# Empty removes the backplane scrape target; a nonempty operations bearer token enables it.
OB_BACKPLANE_OPERATIONS_TOKEN=
# Optional storage profile. Set s3 before first boot to use RustFS.
COMPOSE_PROFILES=
# Bootstrap selects compose.s3.yaml as well when the s3 profile is enabled.
COMPOSE_FILE=compose.yaml
# Optional sibling console URLs; empty disables the link until configured.
OB_GATEWAY_URL=
# Optional Agent Backplane console URL.
OB_BACKPLANE_URL=
# Bootstrap generates OB_GRAFANA_ADMIN_PASSWORD, OB_S3_ACCESS_KEY and OB_S3_SECRET_KEY.
# Root hostname matched by the gateway Caddy health route.
OB_GATEWAY_HEALTH_HOST=localhost
# Host directory for bootstrap state, console metadata and backup textfile metrics.
OB_STATE_DIR=./data
# External volume names. Keep the existing prefix when upgrading.
OB_VOLUME_PREFIX=observability-stack
# Number of complete Checkpoints to retain.
OB_BACKUP_KEEP=7
# Detailed health/version access client IPs; forwarded IPs require a trusted proxy.
OB_OPERATOR_ALLOW=127.0.0.1/8 ::1
# Empty standalone; proxy mode requires exact Edge peer IPs (/32 or /128 allowed).
OB_TRUSTED_PROXIES=
# Configure webhook delivery, or email plus smtp[s]://[user:password@]host:port.
OB_ALERT_WEBHOOK_URL=
OB_ALERT_EMAIL=
OB_SMTP_URL=
# Explicit placeholder permits bootstrap but reports degraded alert delivery.
OB_ALERTS=

# Optional full image references; blank/unset uses the shipped pin in compose.yaml.
# Tags and local images are unvalidated experiments, including stores.
# Caddy image override.
OB_CADDY_IMAGE=
# Grafana image override.
OB_GRAFANA_IMAGE=
# Alloy image override.
OB_ALLOY_IMAGE=
# Loki image override.
OB_LOKI_IMAGE=
# Tempo image override.
OB_TEMPO_IMAGE=
# Mimir image override.
OB_MIMIR_IMAGE=
# Rustfs image override (runtime and init share this reference).
OB_RUSTFS_IMAGE=
